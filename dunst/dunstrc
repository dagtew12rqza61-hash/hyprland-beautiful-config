[global]
    monitor = 0
    follow = mouse
    geometry = "300x50-15+50"
    indicate_hidden = yes
    shrink = no
    transparency = 20
    notification_height = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 15
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#89dceb"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = JetBrains Mono 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    max_icon_size = 48
    icon_path = /usr/share/icons/Papirus/32x32/apps:/usr/share/icons/Papirus/48x48/apps:/usr/share/pixmaps
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/firefox -new-tab
    always_run_script = true
    title = Dunst
    class = Dunst
    startup_notification = false
    verbosity = mesg
    corner_radius = 10
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 10
    icon = dialog-information
    frame_color = "#45475a"

[urgency_normal]
    background = "#313244"
    foreground = "#cdd6f4"
    timeout = 10
    icon = dialog-information
    frame_color = "#89dceb"

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    timeout = 0
    icon = dialog-warning
    frame_color = "#f38ba8"

# Fullscreen rules
[fullscreen_delay_everything]
    fullscreen = off

# Firefox notifications
[firefox]
    appname = firefox
    background = "#313244"
    foreground = "#89dceb"
    frame_color = "#89dceb"

# Spotify notifications
[spotify]
    appname = spotify
    background = "#1DB954"
    foreground = "#ffffff"
    frame_color = "#1DB954"
